{
	"schemaVersion": 1,
	"id": "sharedworlds",
	"version": "${version}",
	"name": "SharedWorlds",
	"description": "Take turns hosting one Minecraft world, kept in a shared or synced folder. Whoever opens it gets the latest copy; nobody else can host it until they quit.",
	"authors": [
		"JustinMcDonald29"
	],
	"contact": {
		"homepage": "https://github.com/JustinMcDonald29/SharedWorlds",
		"sources": "https://github.com/JustinMcDonald29/SharedWorlds",
		"issues": "https://github.com/JustinMcDonald29/SharedWorlds/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/sharedworlds/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.cbiv.sharedworlds.SharedWorlds"
		],
		"client": [
			"com.cbiv.sharedworlds.SharedWorldsClient"
		]
	},
	"mixins": [
		"sharedworlds.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}